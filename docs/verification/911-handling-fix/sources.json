{
  "schemaVersion": 1,
  "items": [
    {
      "id": "geometry-causes",
      "title": "What caused the 911 braking and tilt penalties?",
      "queries": [
        {
          "id": "geometry-probes",
          "source": {
            "label": "Controlled geometry probes",
            "files": [
              {
                "label": "geometry-probes.json"
              },
              {
                "label": "geometry-probes.log"
              },
              {
                "label": "handling_probe.rs"
              }
            ],
            "metricDefinitions": [
              {
                "label": "Definition",
                "definition": "Each substitution changes one geometry factor in the 911 while using the original production VehiclePlugin and identical braking/fast-turn inputs."
              }
            ],
            "caveats": [
              "Substitutions are diagnostic counterfactuals; the production geometry remains unchanged."
            ]
          },
          "columns": [
            "car",
            "variant",
            "braking_m",
            "fast_tilt_deg"
          ],
          "rows": [
            {
              "car": "350z",
              "variant": "stock",
              "braking_m": 38.501095,
              "fast_tilt_deg": 4.3980136
            },
            {
              "car": "redline-911",
              "variant": "stock",
              "braking_m": 39.28057,
              "fast_tilt_deg": 5.205448
            },
            {
              "car": "redline-911",
              "variant": "baseline-wheelbase",
              "braking_m": 38.265217,
              "fast_tilt_deg": 5.2132716
            },
            {
              "car": "redline-911",
              "variant": "baseline-track",
              "braking_m": 39.28057,
              "fast_tilt_deg": 4.263791
            },
            {
              "car": "redline-911",
              "variant": "baseline-radii",
              "braking_m": 39.554146,
              "fast_tilt_deg": 5.3722816
            },
            {
              "car": "redline-911",
              "variant": "baseline-body",
              "braking_m": 39.28057,
              "fast_tilt_deg": 5.205448
            }
          ]
        },
        {
          "id": "force-allocation",
          "source": {
            "label": "Original braking traces",
            "files": [
              {
                "label": "brake-force-audit.json"
              },
              {
                "label": "src/vehicle.rs"
              }
            ],
            "metricDefinitions": [
              {
                "label": "Definition",
                "definition": "Unused front grip and unmet rear braking compare the original 3300 N per-wheel brake request with 1.22 times measured normal load over the 200 ticks from 0.33 to 2 seconds after full-brake input."
              }
            ],
            "caveats": []
          },
          "columns": [
            "car",
            "front_mean_load_N",
            "rear_mean_load_N",
            "unused_front_grip_N",
            "unmet_rear_brake_N",
            "rear_saturated_fraction"
          ],
          "rows": [
            {
              "car": "350z",
              "front_mean_load_N": 9062.6372295,
              "rear_mean_load_N": 4240.2731235,
              "unused_front_grip_N": 4456.41741999,
              "unmet_rear_brake_N": 1426.86678933,
              "rear_saturated_fraction": 1.0
            },
            {
              "car": "redline-911",
              "front_mean_load_N": 9262.203804,
              "rear_mean_load_N": 4049.4297425,
              "unused_front_grip_N": 4699.88864088,
              "unmet_rear_brake_N": 1659.6957141500002,
              "rear_saturated_fraction": 1.0
            },
            {
              "car": "gt4-m3",
              "front_mean_load_N": 8940.9740435,
              "rear_mean_load_N": 4357.6970685,
              "unused_front_grip_N": 4307.9883330699995,
              "unmet_rear_brake_N": 1283.6095764300003,
              "rear_saturated_fraction": 1.0
            }
          ],
          "methods": [
            {
              "language": "calculation",
              "code": "unused_front_grip_N = sum(max(0, 1.22 * wheel_load_N - 3300) for front wheels)\nunmet_rear_brake_N = sum(max(0, 3300 - 1.22 * wheel_load_N) for rear wheels)\nAverage over the same 200 braking ticks."
            }
          ]
        }
      ]
    },
    {
      "id": "fleet-effect",
      "title": "How did the fix affect the matched fleet?",
