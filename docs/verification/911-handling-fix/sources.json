            "metricDefinitions": [
              {
                "label": "Definition",
                "definition": "Braking distance ends at the first completed planar speed at or below 1 m/s. Cornering tilt is the maximum chassis tilt across both turning directions and both approach speeds."
              }
            ],
            "caveats": [
              "The simulation uses shared arcade tuning on a smooth road; these are not real-car performance measurements.",
              "Steering response and braking pitch also change; the separate tradeoff finding retains those outcomes."
