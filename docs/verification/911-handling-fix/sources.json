          "methods": [
            {
              "language": "calculation",
              "code": "braking_improvement_pct = 100 * (1 - after_braking_m / before_braking_m)\nroll_stiffness = (spring_rate / 2 + anti_roll_coefficient) * track_width ** 2"
            }
