    {
      "id": "verification",
      "title": "What evidence verifies the change?",
      "queries": [
        {
          "id": "validation",
          "source": {
            "label": "Run and repository verification",
            "files": [
              {
                "label": "validation.json"
              },
              {
                "label": "candidate-provenance-verification.json"
              },
              {
                "label": "full-verification.log"
              },
              {
                "label": "regression-before.log"
              },
              {
                "label": "regression-after.log"
              }
            ],
            "metricDefinitions": [
              {
                "label": "Definition",
                "definition": "Every candidate run passed effective-input, scenario/asset identity, recorder-health and course checks. All 29,640 measured candidate maneuver ticks had four contacts; the original study had 30,574 because its braking windows lasted longer."
              }
            ],
            "caveats": [
              "The numerical comparison uses the headless build. Native visual acceptance uses a separately hash-identified recorded release build."
            ]
          },
          "columns": [
