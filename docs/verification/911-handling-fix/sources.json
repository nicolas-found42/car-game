    {
      "id": "handling-tradeoffs",
      "title": "What handling tradeoffs remain?",
      "queries": [
        {
          "id": "911-tradeoffs",
          "source": {
            "label": "911 case comparison",
            "files": [
              {
                "label": "comparison.csv"
              },
              {
                "label": "analysis.ipynb"
              }
            ],
            "metricDefinitions": [
              {
                "label": "Definition",
                "definition": "Heading response is the direction-normalized yaw change during the fixed steering window. Exit speed is completed planar speed at its end. Tilt includes both pitch and roll."
              }
            ],
            "caveats": [
              "More heading response alone does not establish better control.",
              "The roll correction deliberately retains baseline arcade roll resistance for narrow tracks."
            ]
          },
          "columns": [
            "case",
            "before_tilt_deg",
            "after_tilt_deg",
            "before_yaw_deg",
            "after_yaw_deg",
            "before_exit_mps",
            "after_exit_mps"
          ],
          "rows": [
